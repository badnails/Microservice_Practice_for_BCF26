# Environment Configuration Template
# Copy this file to .env.dev or .env.prod and customize

# ========================================
# DEVELOPMENT ENVIRONMENT (.env.dev)
# ========================================
# TRAEFIK_HTTP_PORT=3000
# ENVIRONMENT=development
# DOMAIN=localhost
# POSTGRES_USER=devuser
# POSTGRES_PASSWORD=devpass123

# ========================================
# PRODUCTION ENVIRONMENT (.env.prod)
# ========================================
# ENVIRONMENT=production
# DOMAIN=your-domain.com
# ACME_EMAIL=your-email@example.com
# POSTGRES_USER=produser
# POSTGRES_PASSWORD=YourSecurePasswordHere!

# ========================================
# Usage Examples
# ========================================
# Development:
#   docker compose -f docker-compose.yaml -f docker-compose.dev.yaml --env-file .env.dev up
#
# Production:
#   docker compose -f docker-compose.yaml -f docker-compose.prod.yaml --env-file .env.prod up
